# NutriAI Environment Configuration Template
# DO NOT commit real secrets or production database credentials to version control.

# Django Application Settings
DJANGO_SECRET_KEY=your-secure-django-secret-key-here
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost,*

# Database Configuration (Supabase PostgreSQL / SQLite fallback)
# Leave empty for local SQLite development, or provide your Supabase PostgreSQL URI:
# DATABASE_URL=postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
DATABASE_URL=

# FastAPI Machine Learning Service URL
ML_SERVICE_URL=http://127.0.0.1:8001

# CORS Allowed Origins (Comma-separated)
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
